# ---------- MATLAB (matlab/) ----------
# Generated and input data stays out of version control; the folder tree is kept.
matlab/data/**
!matlab/data/**/
!matlab/data/**/.gitkeep
# Golden-model vectors are the contract with the Verilog testbenches: keep them.
# (They are force-tracked; see README.)
# Results that take hours to collect are tracked so they are backed up on GitHub
# (small text and .mat files; a plain `git add matlab/data` picks them up):
!matlab/data/ppa_reports/**
!matlab/data/coefficients/**
!matlab/data/results/01_tap_study/**
!matlab/data/results/09_ppa_report/**
*.asv
*.autosave
slprj/

# ---------- STM32CubeIDE (stm32/) ----------
stm32/**/Debug/
stm32/**/Release/
*.o
*.d
*.su
*.cyclo
*.elf
*.map
*.list
*.launch
stm32/**/.metadata/

# ---------- Vivado (fpga/) ----------
# Scratch projects and checkpoints from run_fpga_ppa.tcl
fpga/vivado_ppa/
*.dcp
# The project is rebuilt from fpga/scripts/create_project.tcl into fpga/vivado/
fpga/vivado/
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.runs/
*.sim/
*.ip_user_files/
*.gen/
*.wdb
*.bit

# ---------- OS ----------
.DS_Store
Thumbs.db
/.metadata/

# ---------- LibreLane (asic/) ----------
# Full LibreLane runs (GDS, DEF, ODB, logs) are too large for git: back them up elsewhere.
# Each run's results are kept: final/metrics.json (every PPA number), ppa_meta.json
# (git commit of the RTL) and resolved.json (the exact flow configuration).
asic/*/runs/**
!asic/*/runs/**/
!asic/*/runs/*/final/metrics.json
!asic/*/runs/*/ppa_meta.json
!asic/*/runs/*/resolved.json
asic/*/config_*ns.json

# ---------- Editor backups (History/ and __Previews/ folders) ----------
History/
__Previews/
